+import { Octokit } from '@octokit/rest';
+import type { InferSelectModel } from 'drizzle-orm';
+import { repositories } from '../../../db/schema.js';
+
+export type RepositoryRecord = InferSelectModel<typeof repositories>;
+
+export async function syncRepository(owner: string, name: string): Promise<RepositoryRecord> {
+  const github = new Octokit();
+  const remote = await github.repos.get({ owner, repo: name });
+  const row = await saveRepository(remote.data);
+  return row;
+}
