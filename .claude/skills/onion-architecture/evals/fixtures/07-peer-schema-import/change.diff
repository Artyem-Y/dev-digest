+import { and, eq, gte, sql } from 'drizzle-orm';
+import type { Database } from '../../../db/client.js';
+import { accounts } from '../schema.js';
+import { invoices } from '../../billing/schema.js';
+
+export interface RevenueSummary {
+  accountId: string;
+  accountName: string;
+  paidInvoiceCount: number;
+  paidTotal: string;
+}
+
+export function createRevenueQuery(db: Database) {
+  return {
+    async listSince(workspaceId: string, since: Date): Promise<RevenueSummary[]> {
+      const rows = await db
+        .select({
+          accountId: accounts.id,
+          accountName: accounts.name,
+          paidInvoiceCount: sql<number>`count(${invoices.id})`,
+          paidTotal: sql<string>`coalesce(sum(${invoices.total}), 0)::text`,
+        })
+        .from(accounts)
+        .leftJoin(
+          invoices,
+          and(
+            eq(invoices.accountId, accounts.id),
+            eq(invoices.status, 'paid'),
+            gte(invoices.paidAt, since),
+          ),
+        )
+        .where(eq(accounts.workspaceId, workspaceId))
+        .groupBy(accounts.id, accounts.name);
+
+      return rows;
+    },
+  };
+}
