@@ -0,0 +1,26 @@
+import { and, inArray, isNull } from 'drizzle-orm';
+import { db } from '../../../db/client.js';
+import { billingOutbox } from '../../../db/schema.js';
+
+export const billingOutboxRepository = {
+  async append(event: { eventType: string; accountId: string; plan: string }) {
+    await db.insert(billingOutbox).values({
+      eventId: crypto.randomUUID(),
+      eventType: event.eventType,
+      payload: event,
+      createdAt: new Date(),
+    });
+  },
+
+  async claimBatch(limit: number) {
+    const rows = await db.select().from(billingOutbox)
+      .where(isNull(billingOutbox.publishedAt))
+      .limit(limit);
+    if (rows.length) {
+      await db.update(billingOutbox)
+        .set({ publishedAt: new Date() })
+        .where(and(isNull(billingOutbox.publishedAt), inArray(billingOutbox.id, rows.map((row) => row.id))));
+    }
+    return rows;
+  },
+};
diff --git a/server/src/modules/billing/infrastructure/billing-outbox-worker.ts b/server/src/modules/billing/infrastructure/billing-outbox-worker.ts
