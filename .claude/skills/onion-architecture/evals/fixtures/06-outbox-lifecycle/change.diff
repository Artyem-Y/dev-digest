+++ b/server/src/modules/billing/infrastructure/renewal-repository.ts
@@ -0,0 +1,15 @@
+import { db } from '../../../db/client.js';
+import { subscriptions } from '../../../db/schema.js';
+import { eq } from 'drizzle-orm';
+
+export const renewalRepository = {
+  async renew(accountId: string, plan: string) {
+    return db.transaction(async (tx) => {
+      const [row] = await tx.update(subscriptions)
+        .set({ plan, renewedAt: new Date() })
+        .where(eq(subscriptions.accountId, accountId))
+        .returning();
+      return { accountId: row.accountId, plan: row.plan };
+    });
+  },
+};
diff --git a/server/src/modules/billing/infrastructure/billing-outbox-repository.ts b/server/src/modules/billing/infrastructure/billing-outbox-repository.ts
