@@ -0,0 +1,16 @@
+import type { Container } from '../../platform/container.js';
+import { createRenewalService } from './application/renewal-service.js';
+import { billingOutboxRepository } from './infrastructure/billing-outbox-repository.js';
+import { renewalRepository } from './infrastructure/renewal-repository.js';
+import { dispatchBillingEvents } from './infrastructure/billing-outbox-worker.js';
+
+export function createBillingModule(container: Container) {
+  const service = createRenewalService({
+    repository: renewalRepository,
+    outbox: billingOutboxRepository,
+  });
+  return {
+    service,
+    dispatch: () => dispatchBillingEvents(container.billingPublisher),
+  };
+}
