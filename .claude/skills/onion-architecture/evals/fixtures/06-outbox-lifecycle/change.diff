@@ -0,0 +1,13 @@
+import type { BillingPublisher } from '../../../platform/billing-publisher.js';
+import { billingOutboxRepository } from './billing-outbox-repository.js';
+
+export async function dispatchBillingEvents(publisher: BillingPublisher) {
+  const messages = await billingOutboxRepository.claimBatch(50);
+  for (const message of messages) {
+    await publisher.publish({
+      id: message.eventId,
+      type: message.eventType,
+      payload: message.payload,
+    });
+  }
+}
