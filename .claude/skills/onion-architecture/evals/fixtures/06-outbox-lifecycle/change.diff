@@ -0,0 +1,23 @@
+import { eq, sql } from 'drizzle-orm';
+import { db } from '../../../db/client.js';
+import { accounts } from '../../../db/schema.js';
+
+interface SubscriptionRenewed {
+  id: string;
+  type: 'SubscriptionRenewed';
+  payload: { accountId: string; plan: string; creditBonus: number };
+}
+
+export async function handleSubscriptionRenewed(event: SubscriptionRenewed) {
+  await db.update(accounts)
+    .set({ credits: sql`${accounts.credits} + ${event.payload.creditBonus}` })
+    .where(eq(accounts.id, event.payload.accountId));
+}
+
+export async function consumeBillingMessage(message: {
+  event: SubscriptionRenewed;
+  ack(): Promise<void>;
+}) {
+  await handleSubscriptionRenewed(message.event);
+  await message.ack();
+}
