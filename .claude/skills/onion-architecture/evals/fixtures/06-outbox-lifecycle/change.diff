+import type { RenewalRepository } from './renewal-repository.js';
+import type { BillingOutbox } from './billing-outbox.js';
+
+export interface RenewalInput {
+  accountId: string;
+  plan: 'standard' | 'pro';
+}
+
+export function createRenewalService(deps: { repository: RenewalRepository; outbox: BillingOutbox }) {
+  return {
+    async renew(input: RenewalInput) {
+      const subscription = await deps.repository.renew(input.accountId, input.plan);
+      await deps.outbox.append({
+        eventType: 'SubscriptionRenewed', accountId: input.accountId, plan: input.plan,
+      });
+      return subscription;
+    },
+  };
+}
