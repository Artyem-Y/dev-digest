--- /dev/null
+++ b/server/src/modules/billing/infrastructure/subscription-repository.ts
@@ -0,0 +1,20 @@
+import { db } from '../../../db/client.js';
+import { subscriptions } from '../../../db/schema.js';
+import { eq } from 'drizzle-orm';
+import type { BillingEvents } from '../../../platform/billing-events.js';
+
+export async function activateSubscription(accountId: string, plan: string, events: BillingEvents) {
+  return db.transaction(async (tx) => {
+    const [subscription] = await tx.update(subscriptions)
+      .set({ plan, active: true })
+      .where(eq(subscriptions.accountId, accountId))
+      .returning();
+
+    await events.subscriptionActivated({ accountId, plan });
+
+    return subscription;
+  });
+}
