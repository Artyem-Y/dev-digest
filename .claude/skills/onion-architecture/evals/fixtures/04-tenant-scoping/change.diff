+import { eq } from 'drizzle-orm';
+import { db } from '../../db/client.js';
+import { projects } from '../../db/schema.js';
+
+export async function getProject(workspaceId: string, projectId: string) {
+  const rows = await db.select().from(projects).where(eq(projects.id, projectId));
+  return rows[0] ?? null;
+}
+
+export async function listProjects(workspaceId: string) {
+  return db.select().from(projects).where(eq(projects.status, 'active'));
+}
+
+export async function renameProject(workspaceId: string, projectId: string, name: string) {
+  return db.update(projects)
+    .set({ name })
+    .where(eq(projects.id, projectId));
+}
