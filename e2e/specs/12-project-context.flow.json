{
  "name": "Attach Project Context and inspect it in a completed review",
  "description": "Hermetic-only fixture: attach the tracked project-spec.md to the Security Reviewer, run that agent with a deterministic provider, and inspect the persisted prompt snapshot.",
  "steps": [
    { "cmd": ["open", "{BASE}/agents"], "label": "open the agent catalog" },
    { "cmd": ["wait", "--load", "networkidle"], "label": "wait for the agents to load" },
    { "cmd": ["wait", "--text", "Security Reviewer"], "label": "find the seeded agent" },
    { "cmd": ["find", "text", "Security Reviewer", "click"], "label": "open Security Reviewer" },
    { "cmd": ["wait", "--text", "Configuration"], "label": "wait for the agent editor" },
    { "cmd": ["find", "role", "button", "click", "--name", "Context"], "label": "open the agent Context tab" },
    { "cmd": ["wait", "--text", "project-spec.md"], "label": "tracked project document appears" },
    { "cmd": ["find", "role", "button", "click", "--name", "Preview docs/project-spec.md"], "label": "preview the document" },
    { "cmd": ["wait", "--text", "Reviews must use the attached project specification."], "label": "document text is visible" },
    { "cmd": ["check", "input[aria-label='Attach docs/project-spec.md']"], "label": "attach the document to the agent" },
    { "cmd": ["wait", "--text", "1 of 1 attached"], "label": "attachment count is updated" },
    { "cmd": ["reload"], "label": "reload the agent editor" },
    { "cmd": ["wait", "--text", "1 of 1 attached"], "label": "attachment survives reload" },
    { "cmd": ["open", "{BASE}/"], "label": "open the PR list" },
    { "cmd": ["wait", "--url", "/pulls"], "label": "land on the seeded repository" },
    { "cmd": ["find", "text", "Add rate limiting to public API endpoints", "click"], "label": "open the seeded PR" },
    { "cmd": ["wait", "--url", "/pulls/482"], "label": "wait for the PR route" },
    { "cmd": ["wait", "--text", "Run Review"], "label": "wait for the review controls" },
    { "cmd": ["find", "role", "button", "click", "--name", "Run Review"], "label": "open the agent selector" },
    { "cmd": ["find", "role", "checkbox", "click", "--name", "Select all agents"], "label": "clear the selection" },
    { "cmd": ["find", "role", "checkbox", "click", "--name", "Security Reviewer"], "label": "select the configured agent" },
    { "cmd": ["find", "role", "button", "click", "--name", "Run selected agents"], "label": "start a deterministic review" },
    { "cmd": ["wait", "--text", "Fixture review complete"], "label": "review completes" },
    { "cmd": ["wait", "--url", "tab=findings"], "label": "wait for agent runs" },
    { "cmd": ["click", "button[aria-label='Open run trace & logs']"], "label": "open the latest run trace" },
    { "cmd": ["wait", "--url", "trace="], "label": "wait for the trace route" },
    { "cmd": ["wait", "1000"], "label": "wait for the trace drawer transition" },
    { "cmd": ["wait", "--text", "project-spec.md"], "label": "Specs read lists the document" },
    { "cmd": ["scroll", "down", "650", "--selector", "[role=dialog] > div:nth-child(2)"], "label": "scroll the trace drawer to prompt assembly" },
    { "cmd": ["find", "text", "Prompt assembly", "click"], "label": "open prompt assembly" },
    { "cmd": ["wait", "500"], "label": "wait for the prompt section" },
    { "cmd": ["scroll", "down", "350", "--selector", "[role=dialog] > div:nth-child(2)"], "label": "scroll to the project context snapshot" },
    { "cmd": ["find", "text", "Project context attached specs", "click"], "label": "open the project context snapshot" },
    { "cmd": ["wait", "--text", "Reviews must use the attached project specification."], "label": "saved prompt contains the document text" }
  ]
}
