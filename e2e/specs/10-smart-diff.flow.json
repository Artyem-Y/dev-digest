{
  "name": "Smart Diff groups files and renders seeded findings",
  "description": "Read-only seeded-data flow for the Smart Diff requirements. It does not invoke an LLM.",
  "steps": [
    { "cmd": ["open", "{BASE}/"], "label": "load the app root" },
    { "cmd": ["wait", "--url", "/pulls"], "label": "land on the PR list" },
    { "cmd": ["find", "text", "Demonstrate Smart Diff ordering", "click"], "label": "open the seeded Smart Diff PR" },
    { "cmd": ["wait", "--url", "/pulls/483"], "label": "navigate to PR detail" },
    { "cmd": ["find", "role", "button", "click", "--name", "Files changed"], "label": "open Files changed" },
    { "cmd": ["wait", "--text", "Core"], "label": "Smart Diff core group is visible" },
    { "cmd": ["wait", "--text", "Tests"], "label": "tests group is visible" },
    { "cmd": ["wait", "--text", "Wiring"], "label": "wiring group is visible" },
    { "cmd": ["wait", "--text", "Docs"], "label": "docs group is visible" },
    { "cmd": ["wait", "--text", "Boilerplate"], "label": "boilerplate group is visible" },
    { "cmd": ["find", "role", "button", "click", "--name", "Boilerplate"], "label": "expand boilerplate" },
    { "cmd": ["wait", "--text", "pnpm-lock.yaml"], "label": "lockfile is in boilerplate" },
    { "cmd": ["wait", "--text", "Seeded inline finding"], "label": "inline finding is visible" },
    { "cmd": ["find", "role", "button", "click", "--name", "Original order"], "label": "switch to original order" },
    { "cmd": ["wait", "--text", "src/config.ts"], "label": "original file order renders" },
    { "cmd": ["find", "role", "button", "click", "--name", "Smart order"], "label": "switch back to smart order" }
  ]
}
